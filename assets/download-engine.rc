1 ICON "assets/download-engine.ico"

1 VERSIONINFO
FILEVERSION @VERSION_NUM@
PRODUCTVERSION @VERSION_NUM@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Xetro\0"
            VALUE "FileDescription", "Download Engine\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "ProductName", "Download Engine\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
