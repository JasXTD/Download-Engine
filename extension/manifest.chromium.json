{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.0.1",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "128",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "downloads",
    "webRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download Engine"
  },
  "optional_permissions": [
    "cookies"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "default_locale": "en"
}
