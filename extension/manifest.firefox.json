{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "3.4.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "downloads",
    "webRequest",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": [
      "i18n-catalog.js",
      "i18n.js",
      "core.js",
      "capture.js",
      "link-recovery.js",
      "page-links.js",
      "browser-login.js",
      "video-button-manager.js",
      "github-download.js",
      "media.js",
      "permission-flow.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Download Engine"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "download-engine@xetro",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"],
        "optional": ["authenticationInfo"]
      }
    }
  },
  "optional_permissions": [
    "cookies"
  ],
  "content_security_policy": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'",
  "default_locale": "en"
}
